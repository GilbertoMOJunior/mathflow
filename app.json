{
  "expo": {
    "name": "UniDrive",
    "slug": "unidrive",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "unidrive",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.uniplac.mathflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#185FA5"
      },
      "package": "br.edu.uniplac.mathflow"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcd53f90-c389-410c-8f7b-6d78faf97f97"
      }
    },
    "owner": "gmo.jr"
  }
}
